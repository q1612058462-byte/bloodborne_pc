diff --git a/tests/test_bloodborne_summon_broker.cpp b/tests/test_bloodborne_summon_broker.cpp
--- a/tests/test_bloodborne_summon_broker.cpp
+++ b/tests/test_bloodborne_summon_broker.cpp
@@ -329,3 +329,39 @@
   CHECK(!remoteDeliveryResponse.contains("\"SeamlessWarp\""));
 
+  // BBSC password and no-password summons must never cross-match, even if the
+  // no-password advertisement is newer. The old wildcard rule stays the default.
+  QByteArray passwordAdvertisement = advertisement;
+  passwordAdvertisement.replace("guest-session", "password-session");
+  passwordAdvertisement.replace("\"UserId\":2465", "\"UserId\":4000");
+  passwordAdvertisement.replace("\"SummonWord\":null", "\"SummonWord\":\"secret\"");
+  QByteArray passwordSearch = search;
+  passwordSearch.replace("\"SummonWord\":null", "\"SummonWord\":\"secret\"");
+  QByteArray wrongPasswordSearch = search;
+  wrongPasswordSearch.replace("\"SummonWord\":null", "\"SummonWord\":\"other\"");
+  Bloodborne::SummonBroker::Options passwordOptions = seamlessOptions;
+  passwordOptions.exactSummonWord = true;
+  Bloodborne::SummonBroker passwordSeamless(passwordOptions);
+  CHECK(passwordSeamless.Advertise(Parse(passwordAdvertisement), passwordAdvertisement,
+                                   10'000).state ==
+        Bloodborne::SummonBroker::State::Advertised);
+  CHECK(passwordSeamless.Advertise(Parse(advertisement), advertisement, 10'001).state ==
+        Bloodborne::SummonBroker::State::Advertised);
+  const auto passwordOnly = passwordSeamless.Search(Parse(passwordSearch), 10'010);
+  CHECK(passwordOnly.size() == 1);
+  CHECK(Parse(passwordOnly.front()).value(QStringLiteral("UserId")).toInteger() == 4000);
+  const auto noPasswordOnly = passwordSeamless.Search(Parse(search), 10'011);
+  CHECK(noPasswordOnly.size() == 1);
+  CHECK(Parse(noPasswordOnly.front()).value(QStringLiteral("UserId")).toInteger() == 2465);
+  CHECK(passwordSeamless.Search(Parse(wrongPasswordSearch), 10'012).isEmpty());
+  Bloodborne::SummonBroker classicPassword(1'000);
+  CHECK(classicPassword.Advertise(Parse(passwordAdvertisement), passwordAdvertisement,
+                                  10'000).state ==
+        Bloodborne::SummonBroker::State::Advertised);
+  CHECK(classicPassword.Search(Parse(search), 10'010).size() == 1);
+  Bloodborne::SummonBroker relaxedOnline(seamlessOptions);
+  CHECK(relaxedOnline.Advertise(Parse(passwordAdvertisement), passwordAdvertisement,
+                                10'000).state ==
+        Bloodborne::SummonBroker::State::Advertised);
+  CHECK(relaxedOnline.Search(Parse(search), 10'010).size() == 1);
+
   std::cout << "Bloodborne summon broker state test passed\n";
